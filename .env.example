# All optional — the app runs fully offline in simulator mode without any of these.

# Google Gemini free tier (https://aistudio.google.com/apikey)
# Used only for diagnosis narratives + message copywriting. Never for money decisions.
GEMINI_API_KEY=

# Razorpay test mode (https://dashboard.razorpay.com/app/keys)
# Enables real webhook ingestion at /api/webhooks/razorpay + real payment link creation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
